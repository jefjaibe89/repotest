# Copy this file to .env and fill in your values
VMANAGE_HOST=192.168.1.100
VMANAGE_PORT=8443
VMANAGE_USER=admin
VMANAGE_PASS=your_password_here
VMANAGE_VERIFY_SSL=false

# Use "mock" for demo data, "live" to connect to a real vManage
SDWAN_MODE=mock

FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
REFRESH_INTERVAL_SECONDS=30
