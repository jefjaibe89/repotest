# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ---- SD-WAN Manager connection ------------------------------------------
# Cisco renamed vManage to Catalyst SD-WAN Manager. MANAGER_* is accepted for
# every setting below and takes precedence; VMANAGE_* keeps working so
# existing deployments need no change.
#   MANAGER_HOST / MANAGER_PORT / MANAGER_USER / MANAGER_PASS
#   MANAGER_VERIFY_SSL / MANAGER_TIMEOUT
VMANAGE_HOST=192.168.1.100
VMANAGE_PORT=8443
VMANAGE_USER=admin
VMANAGE_PASS=your_password_here
# true, false, or a path to the CA bundle that issued the controller's
# certificate. vManage usually presents a private cert, so point this at your
# CA rather than turning verification off — the credentials below are sent
# over this connection. Anything unrecognised is treated as a path and fails
# loudly, so a typo can never silently disable verification.
VMANAGE_VERIFY_SSL=true
# Seconds to wait for vManage before giving up on a request.
VMANAGE_TIMEOUT=20

# ---- Mode ---------------------------------------------------------------
# "mock" serves built-in demo data; "live" talks to the vManage above.
SDWAN_MODE=mock

# ---- Web server ---------------------------------------------------------
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
REFRESH_INTERVAL_SECONDS=30

# ---- Session reuse ------------------------------------------------------
# How long to reuse a vManage login before re-authenticating. vManage idles
# sessions out around 30 min, so keep this comfortably below that.
SESSION_TTL_SECONDS=900

# ---- Health thresholds --------------------------------------------------
CPU_WARN=65
CPU_CRIT=85
MEM_WARN=65
MEM_CRIT=85
ALARM_WINDOW_HOURS=24

# ---- Polling and history ------------------------------------------------
# One background poller collects the fabric on this cadence and every web
# worker serves from the store, so load on vManage does not grow with viewers.
POLL_INTERVAL_SECONDS=30
DB_PATH=sdwan_history.db
POLLER_LOCK_PATH=/tmp/sdwan-dashboard-poller.lock
HISTORY_RETENTION_DAYS=7
HISTORY_WINDOW_HOURS=24

# ---- Alerting -----------------------------------------------------------
# Alerting stays off until ALERTS_ENABLED is true AND a webhook URL is set.
ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=
# slack | teams | generic
ALERT_WEBHOOK_FORMAT=slack
ALERT_WEBHOOK_TIMEOUT=10
ALERT_SCORE_THRESHOLD=70
ALERT_CRITICAL_ALARM_COUNT=1
# How long before a problem that is still ongoing is announced again.
ALERT_COOLDOWN_SECONDS=3600

# ---- Dashboard login ----------------------------------------------------
# Leave DASHBOARD_PASSWORD empty to run without a login. The dashboard serves
# the full network inventory, so set it for anything beyond a local demo.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Set a fixed key to keep sessions valid across restarts; otherwise one is
# generated at startup and everyone is logged out when the process restarts.
SECRET_KEY=
# Enable once the dashboard is served over HTTPS.
SESSION_COOKIE_SECURE=false

# ---- Prometheus ---------------------------------------------------------
# The metrics carry the same network inventory the dashboard shows, so this
# is off until you turn it on. /metrics cannot sit behind the session login
# (a scraper has no session); set a token and scrape with
# "Authorization: Bearer <token>" instead.
METRICS_ENABLED=false
METRICS_TOKEN=

# ---- Content Security Policy --------------------------------------------
# Defence in depth under the output escaping. Turn it off only to debug a
# page that a directive is breaking.
CSP_ENABLED=true
